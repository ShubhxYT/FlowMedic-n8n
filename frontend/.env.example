# Where the browser sends API calls. Leave as the same-origin proxy so the
# dashboard never talks to the FastAPI host directly.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Server-side only: used by app/api/backend/[...path]/route.ts.
# Never expose these with a NEXT_PUBLIC_ prefix.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
FLOWMEDIC_API_KEY=
