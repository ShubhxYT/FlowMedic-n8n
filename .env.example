N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
DATABASE_URL=sqlite:///./flowmedic.db
REQUEST_TIMEOUT=15
# Without an AI key, deterministic mock diagnosis is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional internal service boundary. This never replaces account/session authorization.
# Set the same value on the dashboard server; never use NEXT_PUBLIC_ for this token.
# Per-caller cap on POST /incidents/{id}/diagnose (in-memory, per process).
DIAGNOSE_RATE_LIMIT_PER_MINUTE=5
FLOWMEDIC_API_KEY=
# Local development only: allow mutating routes without FLOWMEDIC_API_KEY.
ALLOW_UNAUTHENTICATED_MUTATIONS=false
# Per-caller cap on POST /incidents/{id}/diagnose (in-memory, per process).
DIAGNOSE_RATE_LIMIT_PER_MINUTE=5
# Seeds one synthetic, non-sensitive incident with deterministic mock diagnosis.
# Do not enable with N8N_API_KEY or AI_API_KEY.
DEMO_MODE=false
# Comma-separated frontend origins allowed to call the API in development.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Read-only n8n monitoring. Disabled unless N8N_BASE_URL and N8N_API_KEY are both configured.
MONITOR_POLL_INTERVAL_SECONDS=60
MONITOR_PAGE_SIZE=50
# Fresh pages are checked every cycle; this bounds older-page backfill work.
MONITOR_BACKFILL_PAGES_PER_CYCLE=1
# SQLite-backed ownership lease for deployments with multiple API processes.
MONITOR_LEASE_SECONDS=120
MONITOR_MAX_RETRIES=3
MONITOR_RETRY_BASE_SECONDS=2
# Retained history powers recent health metrics. Incidents are never removed by this cleanup.
EXECUTION_HISTORY_RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_CLEANUP_BUDGET_SECONDS=300
# Alert rules remain disabled until explicitly configured through the API.
ALERT_DEFAULT_COOLDOWN_SECONDS=300
ALERT_MAX_RETRIES=3
# Optional HTTPS webhook provider. Hostnames are intentionally rejected until destination-pinned
# DNS is available; use only a real globally routable HTTPS IP endpoint. Never commit this value.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
# Optional HMAC-SHA256 secret. It is never returned by the API or stored in the database.
ALERT_WEBHOOK_SIGNING_SECRET=

# Accounts: secure HTTPS cookies are the default; signup is closed until enabled explicitly.
AUTH_REGISTRATION_ENABLED=false
AUTH_ALLOW_INSECURE_COOKIES=false
AUTH_TRUSTED_ORIGINS=https://localhost:3000
AUTH_SESSION_SECONDS=43200
AUTH_INVITE_SECONDS=86400
API_DOCS_ENABLED=false
# Only enable behind an ingress that overwrites X-Forwarded-For and blocks direct traffic.
TRUST_PROXY_IP=false
